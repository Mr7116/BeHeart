{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleSuffixes": [".native", ""],
    "types": [],
    "paths": {
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["index.ts", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["../src/main/**", "../src/core/selftest.ts", "../src/renderer/index.tsx"]
}
